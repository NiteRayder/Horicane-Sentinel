.env.example
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Horicane API v1. Use a strong shared token (at least 32 characters) in both services.
# Local, same-machine example; for separate hosts use a private HTTPS endpoint.
HORICANE_API_BASE_URL=http://127.0.0.1:3001
HORICANE_API_TOKEN=
